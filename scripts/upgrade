#!/bin/bash

source /usr/share/yunohost/helpers
source ./_common.sh

ynh_script_progression "Stopping Pantry Host..."
ynh_systemctl --service="$app" --action="stop" || true
ynh_systemctl --service="${app}-graphql" --action="stop" || true

ynh_script_progression "Updating Pantry Host source..."

tmp_source="$(mktemp -d)"
git clone --depth 1 --branch "$upstream_branch" "$upstream_repo" "$tmp_source"

# Keep the persistent/special files outside the source replacement.
rm -rf "$tmp_source/.git"
rm -rf "$install_dir/node_modules"
find "$install_dir" -mindepth 1 -maxdepth 1 \
    ! -name ".env" \
    -exec rm -rf {} +

cp -a "$tmp_source"/. "$install_dir"/
rm -rf "$tmp_source"

chown -R "$app:$app" "$install_dir"

ynh_script_progression "Restoring persistent paths..."
setup_persistent_paths

ynh_script_progression "Regenerating Pantry Host environment..."
ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 600 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

ynh_script_progression "Installing dependencies and rebuilding..."
install_dependencies_and_build

ynh_script_progression "Updating system configurations..."
ynh_config_add_systemd --service="${app}-graphql" --template="graphql.systemd.service"
ynh_config_add_systemd
ynh_config_add_nginx

ynh_script_progression "Starting Pantry Host..."
ynh_systemctl --service="${app}-graphql" --action="start" --log_path="systemd"
ynh_systemctl --service="$app" --action="start" --log_path="systemd"

ynh_script_progression "Upgrade of $app completed"
