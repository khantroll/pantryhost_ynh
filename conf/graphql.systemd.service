[Unit]
Description=Pantry Host GraphQL API
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/packages/app
EnvironmentFile=__INSTALL_DIR__/.env
Environment="PATH=__PATH_WITH_NODEJS__"

ExecStart=__INSTALL_DIR__/node_modules/.bin/tsx __INSTALL_DIR__/packages/app/graphql-server.ts

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
