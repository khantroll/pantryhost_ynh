[Unit]
Description=Pantry Host web application
After=network.target __APP__-graphql.service
Requires=__APP__-graphql.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/packages/app
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/bin/rex start --host 127.0.0.1 --port __PORT__ --root __INSTALL_DIR__/packages/app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
